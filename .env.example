# ───────────── SCALive Quiz Arena configuration ─────────────
# Copy this file to `.env` (in the project root) and adjust.

# MySQL 8+ destination used by the application. Replace every dummy value.
# Special characters in the username/password must be URL-encoded.
DATABASE_URL="mysql://change_me:change_me@192.0.2.10:3306/scalive_quiz"

# Only needed while running `npm run db:transfer`. Keep the old PostgreSQL
# database available and read-only until the transfer has been verified.
SOURCE_DATABASE_URL="postgresql://old_user:old_password@192.0.2.20:5432/old_database?sslmode=require"

# Password for the /admin panel. CHANGE THIS before a workshop.
ADMIN_PASSWORD="change-me-please"

# Secret used to sign admin login cookies. Any long random string (32+ chars).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"

# Public base URL printed inside the QR code — must be reachable from students' phones.
# In production set this to your real domain, e.g. https://quiz.scalive.in
# Leave empty during local development: the app then uses your laptop's Wi-Fi (LAN) IP.
PUBLIC_URL=""

# HTTP port for the Node server (the Vite dev server runs on 5173 and proxies to this).
PORT=4000

# Optional tuning
# MAX_PARTICIPANTS=300        # maximum students per session
# GET_READY_MS=3000           # "Get ready" countdown before each question
# JOIN_RATE_LIMIT=300         # join attempts per minute per IP (a whole classroom often shares one IP)
# TRUST_PROXY=1               # number of reverse proxies in front of the app (Render/Railway: 1)
